{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breezify-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // New-song notification cron — every 10 minutes.
  // Polls /api/v1/songs/recent, broadcasts diff to all subscribed users.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // Rate-limiting KV namespace.
  // Create with: wrangler kv namespace create BOT_RATE_KV
  // Then replace the id below with the output ID.
  "kv_namespaces": [
    {
      "binding": "RATE_KV",
      "id": "63d7a2f6d2c743f483699c82ea84d4f1"
    }
  ],

  // Secrets (set via: wrangler secret put BOT_TOKEN / wrangler secret put BOT_SECRET)
  //   BOT_TOKEN  — Telegram Bot API token from @BotFather
  //   BOT_SECRET — random string used to verify Telegram webhook requests (min 16 chars)
  //
  // Optional env vars:
  //   API_URL              — override API base URL (default: https://api.sdarm.life/api/v1)
  //   WEB_URL              — public songbook web app URL (used for "Open on website" buttons)
  //   CONTACT_URL          — Telegram contact link shown in the menu
  //   RATE_LIMIT_PER_MIN   — override per-user requests/minute (default: 20)

  "vars": {
    "API_URL": "https://api.sdarm.life/api/v1",
    "WEB_URL": "https://songs.sdarm.life",
    "CONTACT_URL": "https://t.me/maestr_os"
  }
}
