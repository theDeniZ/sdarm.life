{
  "name": "@sdarm/songbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--require ../../tools/silence-next-warnings.cjs' next dev --port 3002",
    "build": "next build --webpack",
    "pages:build": "NODE_OPTIONS='--require ../../tools/patch-cp.cjs' npx opennextjs-cloudflare build",
    "preview": "npx opennextjs-cloudflare preview",
