    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@fontsource/lexend": "^5.2.11",
    "@fontsource/montserrat": "^5.2.8",
    "@sdarm/types": "workspace:*",
    "@sdarm/ui": "workspace:*",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opennextjs/cloudflare": "^1",
    "@sdarm/i18n": "workspace:*",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.0.0",
    "typescript": "^6",
    "typescript-eslint": "^8.60.1",
    "wrangler": "^4"
  }
